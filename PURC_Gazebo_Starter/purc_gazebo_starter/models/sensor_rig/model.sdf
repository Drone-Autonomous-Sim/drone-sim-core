<?xml version="1.0"?>
<sdf version="1.9">
  <model name="sensor_rig">
    <static>true</static>
    <link name="base_link">
      <visual name="body">
        <geometry><box><size>0.15 0.1 0.1</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
      <sensor name="camera" type="camera">
        <pose>0.15 0 0.05 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/purc/camera/image</topic>
        <camera>
          <horizontal_fov>1.047</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>50</far></clip>
        </camera>
      </sensor>
      <sensor name="lidar" type="gpu_lidar">
        <pose>0.15 0 0.1 0 0 0</pose>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/purc/lidar</topic>
        <lidar>
          <scan>
            <horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
            <vertical><samples>16</samples><resolution>1</resolution><min_angle>-0.26</min_angle><max_angle>0.26</max_angle></vertical>
          </scan>
          <range><min>0.1</min><max>30</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
      <sensor name="imu" type="imu">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/purc/imu</topic>
      </sensor>
    </link>
  </model>
</sdf>
